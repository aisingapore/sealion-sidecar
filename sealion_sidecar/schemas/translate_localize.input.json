{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "translate_localize.input",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Text to translate and localize."
    },
    "target_language": {
      "type": "string",
      "minLength": 1,
      "description": "Target language (e.g. bahasa_indonesia, bahasa_malay, thai, vietnamese, tagalog, english, mandarin)."
    },
    "source_language": {
      "type": "string",
      "default": "auto",
      "description": "Source language, or 'auto' to detect."
    },
    "target_region": {
      "type": "string",
      "description": "Region whose conventions and idiom to favor (e.g. indonesia, malaysia, singapore, thailand)."
    },
    "tone": {
      "type": "string",
      "enum": ["neutral", "formal", "informal", "public_service", "marketing", "legal", "friendly", "urgent"],
      "default": "neutral"
    },
    "reading_level": {
      "type": "string",
      "enum": ["plain", "standard", "advanced"],
      "default": "standard",
      "description": "plain = simple everyday language; standard = general; advanced = technical/academic."
    }
  },
  "required": ["text", "target_language"],
  "additionalProperties": false
}
