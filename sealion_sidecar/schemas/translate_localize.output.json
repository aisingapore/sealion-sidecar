{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "translate_localize.output",
  "type": "object",
  "properties": {
    "translation": {
      "type": "string",
      "description": "The localized translation."
    },
    "localization_notes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Decisions made beyond a literal translation — tone shifts, idiom swaps, cultural choices, words avoided."
    },
    "target_language": {
      "type": "string"
    },
    "target_region": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "model": {
      "type": "string"
    }
  },
  "required": ["translation", "localization_notes", "target_language", "target_region", "confidence", "model"],
  "additionalProperties": false
}
